PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
API_PORT=4000
# PORT is assigned by Render; local launcher defaults frontend to 3000.
# Local SQLite fallback (only when DATABASE_URL is absent):
DATABASE_PATH=backend/data/school.sqlite
# Supabase Connect > Session pooler (or direct when IPv6 is available):
# DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_POOL_MAX=5
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_SSL=false is allowed only for localhost PostgreSQL tests.
# Existing .dev.vars credentials are also read by the Node backend.
# ADMIN_PASSWORD_HASH=
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=
# Telegram bot: private admin account only; never use NEXT_PUBLIC_ variables.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_ID=
# TELEGRAM_ENABLED=false

# Render/Vercel: same server-only secret on both hosts, never NEXT_PUBLIC.
# API_PROXY_SECRET=
# PostgreSQL: use Supabase backups / scheduled pg_dump. SQLite backup is local only.
# BACKUP_ENABLED=false
# BACKUP_DIR=backend/data/backups
# BACKUP_STORAGE_BUCKET=school-backups

# Optional PUBLIC contacts: set on Vercel and redeploy to apply changes.
# NEXT_PUBLIC_SCHOOL_ADDRESS=
# NEXT_PUBLIC_SCHOOL_PHONE=
# NEXT_PUBLIC_SCHOOL_EMAIL=
