{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "./.next/types/**/*.ts",
    "./.next/dev/types/**/*.ts",
    "../packages/contracts/**/*.ts"
  ],
  "exclude": ["node_modules", "tests"]
}
