{
  "name": "bekobod-maktab",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:frontend": "npm run dev --workspace @school/frontend",
    "dev:backend": "npm run dev --workspace @school/backend",
    "build": "npm run build --workspace @school/frontend",
    "start": "node scripts/run.mjs start",
    "start:frontend": "npm run start --workspace @school/frontend",
    "start:backend": "npm run start --workspace @school/backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build:backend && npm run lint && npm test && npm run build",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "db:migrate:local": "tsx backend/scripts/migrate-sqlite.ts",
    "db:import:legacy": "tsx backend/scripts/import-legacy.ts",
    "admin:setup": "node backend/scripts/setup-admin.mjs",
    "images:setup": "node backend/scripts/setup-image-storage.mjs",
    "backup:create": "tsx backend/scripts/backup.ts",
    "backup:restore": "tsx backend/scripts/restore-backup.ts",
    "build:backend": "npm run build --workspace @school/backend",
    "db:migrate": "npm run db:migrate --workspace @school/backend",
    "db:import:postgres": "npm run db:import:sqlite --workspace @school/backend"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/contracts"
  ]
}
